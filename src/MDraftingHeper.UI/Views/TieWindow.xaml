<Window x:Class="MDraftingHeper.UI.Views.TieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:MDraftingHeper.UI.Preview"
        Title="MDraftingHeper — Tie &amp; Hook"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="DialogStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="10" Width="600">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Select Bars…" Command="{Binding SelectBarsCommand}" ToolTip="Pick Circle A, then Circle B (longitudinal bars)" />
            <Button Content="Preview &amp; Draw…" Command="{Binding DrawCommand}" IsDefault="True"
                    ToolTip="Shows the tie in model space: Enter accepts, F flips, Esc cancels" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <GroupBox Header="Hook angle">
                    <ListBox ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding SelectedAngle}" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <p:PathPreview Shapes="{Binding Schematic}" Width="96" Height="56" />
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Tie diameter:" VerticalAlignment="Center" Margin="0,2,6,2" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TieSizes}" SelectedItem="{Binding TieSize}" Margin="0,2" />
                    <TextBlock Grid.Column="2" Text="Hook position:" VerticalAlignment="Center" Margin="12,2,6,2" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding EndOptions}" SelectedItem="{Binding Ends}" Margin="0,2" />
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Flip direction" IsChecked="{Binding Flip}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding LineweightText}" Style="{StaticResource Muted}" Margin="12,4,0,0" FontSize="11" />
                </Grid>

                <GroupBox Header="Selected longitudinal bars">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Circle A diameter:" Margin="0,1,8,1" />
                        <TextBlock Grid.Column="1" Text="{Binding DiameterAText}" />
                        <TextBlock Grid.Row="1" Text="Circle B diameter:" Margin="0,1,8,1" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiameterBText}" />
                        <TextBlock Grid.Row="2" Text="Effective diameter:" Margin="0,1,8,1" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectiveText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Text="Centre spacing:" Margin="0,1,8,1" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpacingText}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Hook preset">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" DisplayMemberPath="DisplayName" />
                        <TextBlock Text="{Binding PresetProvenance}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Inside bend diameter (mm):" Margin="0,2,6,2" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MandrelText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsManual, Converter={StaticResource Not}}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Straight tail length (mm):" Margin="0,2,6,2" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TailText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsManual, Converter={StaticResource Not}}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Clear gap to bar (mm):" Margin="0,2,6,2" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Rfit:" Margin="12,2,4,2" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FitRadiusText}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Rmandrel:" Margin="12,2,4,2" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MandrelRadiusText}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Centreline radius:" Margin="12,2,4,2" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding CentrelineRadiusText}" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Clearance:" Margin="12,2,4,2" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ClearanceText}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="{Binding Messages}" Style="{StaticResource Warning}" />
            </StackPanel>

            <p:PathPreview Grid.Column="1" Shapes="{Binding Preview}" Message="Select two bars to preview" Height="300" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
