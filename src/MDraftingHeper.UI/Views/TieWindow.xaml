<Window x:Class="MDraftingHeper.UI.Views.TieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:MDraftingHeper.UI.Preview"
        Title="MDraftingHeper — Tie &amp; Hook"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="DialogStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="10" Width="620">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{Binding SelectButtonText}" Command="{Binding SelectBarsCommand}"
                    ToolTip="Temporarily close this window and pick the longitudinal bar circles" />
            <Button Content="Apply &amp; Draw" Command="{Binding DrawCommand}" IsDefault="True"
                    ToolTip="Draw the previewed centreline as one polyline" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="Open Tie" IsChecked="{Binding IsOpenTie}" Margin="0,0,16,0" GroupName="Mode" />
                    <RadioButton Content="Closed Hoop" IsChecked="{Binding IsHoop}" GroupName="Mode" />
                </StackPanel>
                <TextBlock Text="{Binding BarsText}" Style="{StaticResource Muted}" Margin="0,0,0,6" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Tie diameter:" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TieSizes}" SelectedItem="{Binding TieSize}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Text="Start A hook:" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding AngleA}"
                              ItemTemplate="{StaticResource LabelItem}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="tail" VerticalAlignment="Center" Margin="10,2,6,2" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TailAText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="End B hook:" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding AngleB}"
                              ItemTemplate="{StaticResource LabelItem}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="tail" VerticalAlignment="Center" Margin="10,2,6,2" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TailBText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Text="Hook position:" VerticalAlignment="Center" Margin="0,2,8,2"
                               Visibility="{Binding IsOpenTie, Converter={StaticResource Visible}}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding EndOptions}" SelectedItem="{Binding Ends}"
                              ItemTemplate="{StaticResource LabelItem}" Margin="0,2" HorizontalAlignment="Left" Width="140"
                              Visibility="{Binding IsOpenTie, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Row="3" Text="Closure corner:" VerticalAlignment="Center" Margin="0,2,8,2"
                               Visibility="{Binding IsHoop, Converter={StaticResource Visible}}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding ClosureCorners}" SelectedItem="{Binding Closure}"
                              Margin="0,2" HorizontalAlignment="Left" Width="200"
                              Visibility="{Binding IsHoop, Converter={StaticResource Visible}}" />

                    <TextBlock Grid.Row="4" Text="Clear gap (mm):" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                    <CheckBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="Flip direction" IsChecked="{Binding Flip}"
                              VerticalAlignment="Center" Margin="10,2,0,2" />

                    <TextBlock Grid.Row="5" Text="Mandrel Ø:" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MandrelText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding RadiusText}" VerticalAlignment="Center" Margin="10,2,0,2" />
                </Grid>

                <TextBlock Text="{Binding RulesNote}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <TextBlock Text="{Binding LineweightText}" Style="{StaticResource Muted}" FontSize="11" />
                <TextBlock Text="{Binding Messages}" Style="{StaticResource Warning}" Margin="0,4,0,0" />
            </StackPanel>

            <p:PathPreview Grid.Column="1" Shapes="{Binding Preview}" Message="Select bars to preview" Height="280" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
