<Window x:Class="MDraftingHeper.UI.Views.RebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:MDraftingHeper.UI.Preview"
        Title="MDraftingHeper — Rebar Percentage"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="DialogStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="10" Width="560">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Select…" Command="{Binding SelectCommand}" ToolTip="Select rebar Circles, then the closed boundary polyline" />
            <Button Content="Insert Table" Command="{Binding InsertTableCommand}" IsDefault="True" />
            <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                           Text="Select direct rebar Circle entities and one closed planar polyline (gross concrete section). Nested blocks are not read." />
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" Height="150" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bar size" Binding="{Binding BarSize}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                        <DataGridTextColumn Header="Area/bar (mm²)" Binding="{Binding AreaPerBar}" Width="100" />
                        <DataGridTextColumn Header="Total (mm²)" Binding="{Binding TotalArea}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bars counted:" Margin="0,2,6,2" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalCountText}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Column="2" Text="As:" Margin="12,2,6,2" />
                    <TextBlock Grid.Column="3" Text="{Binding AsText}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Ag (gross):" Margin="0,2,6,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AgText}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ρ = As/Ag:" Margin="12,2,6,2" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding RhoText}" FontWeight="Bold" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="Target ρ (%):" Margin="0,4,6,2" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetRhoText, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,4,0,2"
                             ToolTip="Optional. Leave empty if not needed." />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="As,target:" Margin="12,4,6,2" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AsTargetText}" Margin="0,4,0,2" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="As − As,target:" Margin="12,2,6,2" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DifferenceText}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="Ø tolerance (mm):" Margin="0,2,6,2" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiameterTolerance, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Margin="0,2" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Warning}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Exclude the flagged bars and continue" IsChecked="{Binding AcceptExclusions}" Margin="0,4,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FlaggedCount}" Value="0">
                                    <Setter Property="UIElement.Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="{Binding UnitsNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="The inserted table is a snapshot; it does not update when bars change." />
            </StackPanel>

            <p:PathPreview Grid.Column="1" Shapes="{Binding Preview}" Message="Select bars and boundary" Height="240" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
