<Window x:Class="MDraftingHeper.UI.Views.CustomBarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Longitudinal Bar" Width="330" Height="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="*"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Bar Name:" Margin="0,4,8,4"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2"/>
        <TextBlock Grid.Row="1" Text="Diameter (mm):" Margin="0,4,8,4"/><TextBox x:Name="DiameterBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
        <TextBlock Grid.Row="2" Text="X (mm):" Margin="0,4,8,4"/><TextBox x:Name="XBox" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
        <TextBlock Grid.Row="3" Text="Y (mm):" Margin="0,4,8,4"/><TextBox x:Name="YBox" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Grid.ColumnSpan="2" Foreground="#FFB3261E" TextWrapping="Wrap" Margin="0,5"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Apply" Click="Apply_Click" IsDefault="True"/><Button Content="Cancel" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
