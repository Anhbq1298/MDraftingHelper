<Window x:Class="MDraftingHeper.UI.Views.TieBarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:MDraftingHeper.UI.Preview"
        Title="Tie Bar References &amp; Properties" Width="720" Height="520" MinWidth="650" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Click="Apply_Click" IsDefault="True" MinWidth="84" Margin="6,0,0,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="6,0,0,0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock x:Name="PickerHelp" DockPanel.Dock="Top" Text="Click Circle A, then a different Circle B. Only longitudinal bars are shown." TextWrapping="Wrap" Margin="0,0,0,6" />
                <p:BarPickerCanvas x:Name="Picker" Focusable="True" />
            </DockPanel>
            <StackPanel Grid.Column="1">
                <GroupBox Header="Bar references" Padding="6" Margin="0,0,0,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Bar A:" VerticalAlignment="Center"/><ComboBox x:Name="BarABox" Grid.Column="1" DisplayMemberPath="BarName" SelectionChanged="BarBox_SelectionChanged" />
                        <TextBlock Grid.Row="1" Text="Bar B:" VerticalAlignment="Center"/><ComboBox x:Name="BarBBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="BarName" SelectionChanged="BarBox_SelectionChanged" />
                        <TextBlock x:Name="InspectionText" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#FF555555" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="Tie properties" Padding="6">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Diameter:" Margin="0,3,8,3"/><ComboBox x:Name="SizeBox" Grid.Column="1" Margin="0,1"/>
                        <TextBlock Grid.Row="1" Text="Hook A:" Margin="0,3,8,3"/><ComboBox x:Name="HookABox" Grid.Row="1" Grid.Column="1" Margin="0,1"/>
                        <TextBlock Grid.Row="2" Text="Hook B:" Margin="0,3,8,3"/><ComboBox x:Name="HookBBox" Grid.Row="2" Grid.Column="1" Margin="0,1"/>
                        <CheckBox x:Name="FlipBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Flip hook orientation" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Text="Inside mandrel (mm):" Margin="0,3,8,3"/><TextBox x:Name="MandrelBox" Grid.Row="4" Grid.Column="1"/>
                        <TextBlock Grid.Row="5" Text="Straight tail (mm):" Margin="0,3,8,3"/><TextBox x:Name="TailBox" Grid.Row="5" Grid.Column="1"/>
                        <TextBlock Grid.Row="6" Text="Clear gap (mm):" Margin="0,3,8,3"/><TextBox x:Name="GapBox" Grid.Row="6" Grid.Column="1"/>
                    </Grid>
                </GroupBox>
                <TextBlock x:Name="ErrorText" Foreground="#FFB3261E" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
