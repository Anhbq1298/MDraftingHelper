<Window x:Class="MDraftingHeper.UI.Views.SteelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:MDraftingHeper.UI.Preview"
        Title="MDraftingHeper — Steel Section"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="DialogStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="10" Width="640">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Insert Block…" Command="{Binding InsertCommand}" IsDefault="True" ToolTip="Pick the insertion point in model space" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="After insertion, select the block and press Ctrl+1: the numeric dimensions are native Dynamic Block properties. Family/profile are chosen here only." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Search profiles" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryNote}" Style="{StaticResource Muted}" FontSize="11" />
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Display" Height="260" VerticalAlignment="Top"
                         ToolTip="Pick a catalogue size (dimensions locked) or (Custom dimensions) to type your own" />
            </DockPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Dimensions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DataContext.IsCustom, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Locked for catalogue sizes; select (Custom dimensions) in the list to edit. All dimensions in mm. r is the OUTER corner radius for SHS/RHS (inner = r − t) and the root radius for UB/UC."
                           Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Insertion anchor:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}" SelectedItem="{Binding Anchor}" Margin="0,1" />
                    <TextBlock Grid.Row="1" Text="Rotation (°):" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RotationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                </Grid>
                <CheckBox Content="Centre axes" IsChecked="{Binding CentreAxes}" />
                <CheckBox Content="Profile label" IsChecked="{Binding ProfileLabel}" Margin="0,2,0,4" />
                <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Provenance}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3" />
                <TextBlock Text="{Binding AreaText}" Style="{StaticResource Muted}" FontSize="11" />
                <TextBlock Text="{Binding Messages}" Style="{StaticResource Warning}" Margin="0,4,0,0" />
            </StackPanel>

            <p:PathPreview Grid.Column="2" Shapes="{Binding Preview}" Message="Invalid dimensions" Height="290" VerticalAlignment="Top" />
        </Grid>
    </DockPanel>
</Window>
